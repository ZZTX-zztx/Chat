{
  "name": "chat",
  "main": "src/worker.js",
  "compatibility_date": "2024-01-01",
  "kv_namespaces": [
    {
      "binding": "CHAT_KV",
      "id": "3f48e77d245f41bfa2fbc1852bf7c98b"
    }
  ],
  "vars": {
    "ROOM_ID": "default-room",
    "MAX_MESSAGES": "500",
    "API_KEY": "",
    "APP_VERSION_CODE": "8",
    "APP_VERSION_NAME": "1.2.6",
    "APP_DOWNLOAD_URL": "https://chat-apk.zztxer.dpdns.org/1.2.6-app-debug.apk",
    "APP_CHANGELOG": "1. 【新增】添加密码登录功能，支持用户名密码注册和登录\n2. 【新增】登录成功后获取 token，后续请求自动携带身份认证\n3. 【新增】token 有效期为 24 小时，过期后需重新登录\n4. 【新增】登录后直接进入聊天，不再显示设置对话框\n5. 【修复】消息气泡靠上对齐问题",
    "APP_FORCE_UPDATE": "false",
    "APP_MIN_SDK": "24",
    "WIN_VERSION_CODE": "20",
    "WIN_VERSION_NAME": "1.1.9",
    "WIN_DOWNLOAD_URL": "https://chat-windows.zztxer.dpdns.org/download",
    "WIN_CHANGELOG": "1. 【修复】下载路径问题，支持自定义下载文件夹\n2. 【修复】PyInstaller打包警告问题\n3. 【优化】更新检查逻辑\n4. 【优化】窗口样式和按钮显示",
    "WIN_FORCE_UPDATE": "false"
  }
}